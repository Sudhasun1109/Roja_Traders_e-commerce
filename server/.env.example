PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=whatsapp_ecommerce
DB_PORT=3306

# JWT Secrets (Separate for Customer & Admin security)
JWT_SECRET=customer_jwt_secret_key_whatsapp_showcase_2026
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=admin_jwt_secret_key_whatsapp_showcase_2026
ADMIN_JWT_EXPIRES_IN=1d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# OTP Configuration
OTP_EXPIRY_MINUTES=5
# SMS Provider Mode: 'mock' for local dev (logs OTP & returns in debug response), 'production' for live SMS gateway
SMS_PROVIDER_MODE=mock
